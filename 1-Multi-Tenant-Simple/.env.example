# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Chat model (default: gpt-5-mini)
CHAT_MODEL=gpt-5-mini

# Embedding model (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small
QUERY_REWRITE_MODEL=gpt-5-mini
QUERY_REWRITE_ENABLED=true

# SQLite database path (default: data/demo.sqlite3)
SQLITE_PATH=data/demo.sqlite3

# Knowledge base root directory (default: data/kb)
KB_ROOT=data/kb

# ChromaDB mode: "in-memory" or "persistent" (default: in-memory)
CHROMA_MODE=in-memory
CHROMA_PERSIST_PATH=data/chroma

# Number of top chunks to retrieve (default: 4)
RETRIEVAL_TOP_K=4

# Max chat history messages to include (default: 8)
CHAT_HISTORY_MAX_MESSAGES=8

# App host and port
APP_HOST=127.0.0.1
APP_PORT=8000

# LangSmith (optional - for tracing/observability)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=multi-tenant-rag-chatbot
