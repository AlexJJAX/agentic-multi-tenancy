OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_BASE_URL=http://localhost:8000
IDENTITY_ISSUER=http://localhost:8000
SESSION_SECRET=

GATEWAY_MCP_URL=http://127.0.0.1:8000/mcp
ORDERS_TARGET_URL=http://127.0.0.1:8000/internal/tools/orders
TVM_URL=http://127.0.0.1:8000/internal/tvm
PROPERTIES_MCP_URL=http://127.0.0.1:8000/internal/mcp/properties

GATEWAY_SERVICE_CLIENT_ID=mcp-gateway-service
GATEWAY_SERVICE_CLIENT_SECRET=
ORDERS_SERVICE_CLIENT_ID=orders-target-service
ORDERS_SERVICE_CLIENT_SECRET=
GATEWAY_CAPABILITY_PRIVATE_KEY_PATH=.local/keys/gateway_private.pem
GATEWAY_CAPABILITY_PUBLIC_KEY_PATH=.local/keys/gateway_public.pem
IDENTITY_PRIVATE_KEY_PATH=.local/keys/identity_private.pem
IDENTITY_PUBLIC_KEY_PATH=.local/keys/identity_public.pem

SQLITE_PATH=.local/demo.db
CHROMA_PERSIST=false
DEV_AUTO_MIGRATE=true
DEV_AUTO_SEED=true
DEV_GENERATE_KEYS=true

LOG_LEVEL=INFO
ENABLE_DEBUG_TRACE=true
